# Local PostgreSQL (used by docker-compose.yml)
# Database: baseball_intelligence
# User: baseball
# Host: localhost
# Port: 5432
POSTGRES_PASSWORD=replace_with_local_password

# Backend / Alembic connection string
DATABASE_URL=postgresql+psycopg://baseball:replace_with_local_password@localhost:5432/baseball_intelligence

# Automated tests require a dedicated database. pytest reads TEST_DATABASE_URL
# from the process environment and does not fall back to DATABASE_URL or .env.
# Export this variable before running integration tests; do not point it at
# baseball_intelligence.
# TEST_DATABASE_URL=postgresql+psycopg://baseball:replace_with_local_password@localhost:5432/baseball_intelligence_test
